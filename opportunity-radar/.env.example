# Copy to .env beside this file. Local embedding requires no API keys.
# Defaults resolve relative to opportunity-radar/, regardless of working directory.
DATABASE_URL=sqlite:///data/opportunities.sqlite3
CHROMA_PATH=chroma_store
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://kadiekeslar.github.io
AUTO_REFRESH=1
REFRESH_HOURS=4
